DATABASE_URL=
DEMO_CLEANING_ID=11111111-1111-1111-1111-111111111111
CLEANTRACK_UPLOAD_DIR=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
# Legacy fallback used only when TELEGRAM_ADMIN_CHAT_IDS is absent.
TELEGRAM_ADMIN_CHAT_ID=
# Telegram username the /start partner CTA links to, WITHOUT the leading @.
TELEGRAM_ADMIN_USERNAME=
CLEANTRACK_BASE_URL=https://cleantrack.ru

# OLNOO CRM lead sync (lib/server/crm-sync.ts): after a Telegram order is saved in CleanTrack's
# own database, a commercial-context lead is sent to POST <OLNOO_CRM_URL>/api/leads/inbound in
# olnoo-admin (project=cleantrack). Server-only — never exposed to the browser, never in
# NEXT_PUBLIC_*. OLNOO_CRM_URL must be the CRM's origin only (https, no userinfo/query/hash);
# crm-sync.ts appends /api/leads/inbound itself. OLNOO_CRM_API_KEY must match OLNOO_CRM_API_KEY in
# olnoo-admin's own env (sent as "Authorization: Bearer <key>"). Missing either one just skips the
# CRM sync (logged) — the CleanTrack order itself always saves regardless.
OLNOO_CRM_URL=https://admin.olnoo.com
OLNOO_CRM_API_KEY=
